# Salin menjadi .env lalu isi. File .env tidak di-commit.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://sit:sit@localhost:5432/tbsu_dev
# Database khusus tes otomatis. Nama WAJIB berakhiran _test (isinya dikosongkan setiap tes).
DATABASE_URL_TEST=postgres://sit:sit@localhost:5432/tbsu_test
# Acak, minimal 32 karakter (dipakai mulai Fase 2).
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
SESSION_IDLE_MENIT=60
SESSION_ABSOLUT_JAM=12
# Password awal akun owner saat pnpm db:seed (wajib diganti saat login pertama).
SEED_OWNER_PASSWORD=ganti
SEED_CONTOH=false
LOG_LEVEL=info
TZ=UTC
