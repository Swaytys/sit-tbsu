# Salin menjadi .env lalu isi. File .env tidak di-commit.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://sit:sit@localhost:5432/tbsu_dev
# Database khusus tes otomatis. Nama WAJIB berakhiran _test (isinya dikosongkan setiap tes).
DATABASE_URL_TEST=postgres://sit:sit@localhost:5432/tbsu_test
# Sesi login (docs/04 §7): menit tanpa kegiatan sebelum sesi berakhir, dan umur sesi paling lama.
SESSION_IDLE_MENIT=60
SESSION_ABSOLUT_JAM=12
# Password awal akun owner saat pnpm db:seed (wajib diganti saat login pertama).
SEED_OWNER_PASSWORD=ganti
LOG_LEVEL=info
TZ=UTC
# 1 = pesan kode persetujuan tidak benar-benar dikirim (hanya kotak keluar uji); untuk server tes e2e.
# Diabaikan di produksi.
# SALURAN_TIRUAN=1
# Batas percobaan login per menit per IP di luar produksi (bawaan 20); server tes e2e memakai mis. 600.
# LOGIN_MAKS_PER_MENIT=600
# Folder berkas unggahan (gambar barang). Kosongkan untuk memakai storage/ di root repo.
# STORAGE_DIR=D:\sit-tbsu\storage

# --- Produksi (server toko, Fase 8; diisi otomatis oleh scripts/server/pasang-server.ps1) ---
# NODE_ENV=production
# PORT=443
# PORT_HTTP_ALIH=80
# LOG_FILE=D:\sit-tbsu\log\server.log
# HTTPS_PFX=D:\sit-tbsu\sertifikat\server.pfx
# HTTPS_PFX_PASSWORD=
# WEB_DIST=  (bawaan apps/web/dist)
# ORIGIN_TAMBAHAN=https://server-toko.tailxxxx.ts.net:8443

# --- Cadangan data (K-084): restic + pg_dump. Tanpa CADANGAN_REPO_LOKAL, cadangan belum diatur. ---
# CADANGAN_REPO_LOKAL=E:\cadangan-tbsu
# CADANGAN_REPO_CLOUD=rclone:gdrive:BonsaiUrip-cadangan
# Kata sandi enkripsi cadangan (minimal 8 karakter). HILANG = cadangan tidak bisa dibuka.
# CADANGAN_SANDI=
# CADANGAN_RESTIC=restic
# CADANGAN_RCLONE=
# Folder bin PostgreSQL (pg_dump, pg_restore); kosong = dicari di PATH.
# CADANGAN_PG_BIN=
# Jam cadangan harian (WIB, 0-23).
# CADANGAN_JAM=21
