{
  "name": "sit-tbsu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @sit/web run test:e2e",
    "test:e2e:kritis": "pnpm --filter @sit/web run test:e2e:kritis",
    "db:migrate": "pnpm --filter @sit/api run db:migrate",
    "db:uji-migrasi": "pnpm --filter @sit/api run db:uji-migrasi",
    "db:seed": "pnpm --filter @sit/api run db:seed",
    "db:reset": "pnpm --filter @sit/api run db:reset",
    "db:audit": "pnpm --filter @sit/api run db:audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,css,html,yaml,yml,md}": "prettier --write --ignore-unknown"
  }
}
